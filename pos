<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>POS Cashier - Courtside Kitchen</title>
<style>
*{box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#ececec;margin:0;padding:12px;color:#333}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding:0 4px}
h1{margin:0;font-size:22px;color:#0066cc}
.pos-container{display:grid;grid-template-columns:1.6fr 1.1fr;gap:14px;max-width:1200px;margin:auto}
.card{background:#fff;padding:14px;border-radius:12px;box-shadow:0 2px 5px rgba(0,0,0,0.05)}
.category-filter{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;margin-bottom:10px}
.category-filter button{padding:8px 12px;background:#e0e0e0;border:none;border-radius:20px;font-size:13px;font-weight:bold;cursor:pointer;white-space:nowrap;color:#333}
.category-filter button.active{background:#0066cc;color:#fff}
.pos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;max-height:75vh;overflow-y:auto;padding-right:4px}
.pos-item{background:#fdfdfd;border:1px solid #e0e0e0;border-radius:8px;padding:12px 8px;text-align:center;cursor:pointer;user-select:none;transition:transform 0.1s,border-color 0.1s}
.pos-item:active{transform:scale(0.97);border-color:#0066cc}
.pos-item-name{font-weight:bold;font-size:14px;margin-bottom:6px;line-height:1.2}
.pos-item-price{color:#0066cc;font-weight:bold;font-size:14px}
.cart-header{font-size:18px;font-weight:bold;border-bottom:2px solid #eee;padding-bottom:8px;margin-top:0}
.cart-list{max-height:38vh;overflow-y:auto;margin:10px 0}
.cart-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0f0f0}
.qty-ctrl{display:flex;gap:4px;align-items:center}
.qty-ctrl button{padding:4px 10px;background:#0066cc;color:#fff;border:none;border-radius:4px;font-weight:bold;cursor:pointer}
input, textarea, select{width:100%;padding:10px;margin:6px 0;border:1px solid #ccc;border-radius:6px;font-size:14px}
.total-box{font-size:22px;font-weight:bold;margin:12px 0;padding-top:10px;border-top:2px solid #333;display:flex;justify-content:space-between}
.checkout-btn{width:100%;padding:14px;background:#4caf50;color:#fff;border:none;border-radius:8px;font-size:18px;font-weight:bold;cursor:pointer}
.checkout-btn:hover{background:#43a047}

@media(max-width:850px){
  .pos-container{grid-template-columns:1fr}
  .pos-grid{max-height:45vh}
}
</style>
</head>
<body>

<div class="pos-container">
  <div class="card">
    <div class="header">
      <h1>Courtside Kitchen POS</h1>
      <span id="prodCount" style="color:#666;font-size:13px;font-weight:bold;">Loading menu...</span>
    </div>
    <input id="posSearch" placeholder="🔍 Search product..." oninput="filterCatalog()">
    <div id="catFilter" class="category-filter"></div>
    <div id="posCatalog" class="pos-grid"></div>
  </div>

  <div class="card">
    <h2 class="cart-header">🛒 Walk-in Ticket</h2>
    <input id="customerName" placeholder="Customer Name (e.g. Table 1 / Walk-in)" value="Walk-in">
    <textarea id="orderNotes" placeholder="Order requests / notes" style="height:50px"></textarea>
    <select id="paymentMethod">
      <option value="Cash">Cash Payment</option>
      <option value="GCash">GCash</option>
      <option value="BPI">BPI</option>
    </select>

    <div id="cartList" class="cart-list">
      <div style="text-align:center;color:#888;padding:20px 0;">Cart is empty.<br>Tap items to add.</div>
    </div>

    <div class="total-box">
      <span>Total:</span>
      <span>₱<span id="cartTotal">0</span></span>
    </div>

    <button id="submitBtn" class="checkout-btn" onclick="submitPosOrder()">🚀 Charge & Send to Kitchen</button>
  </div>
</div>

<script type="module">
import {initializeApp} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
import {getFirestore, collection, getDocs, doc, runTransaction, setDoc} from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js';

const app = initializeApp({
  apiKey: 'AIzaSyDRCXXhgQrMNan2lK-5WN1f5fcXBdzHj2I',
  authDomain: 'courtside-kitchen.firebaseapp.com',
  projectId: 'courtside-kitchen',
  storageBucket: 'courtside-kitchen.appspot.com',
  messagingSenderId: '1062967764463',
  appId: '1:1062967764463:web:0b6dbbfec0904d0f0c05a1'
});
const db = getFirestore(app);

let products = [];
let cart = {};
let bobaMap = {};
let selectedCategory = 'ALL';

async function loadMenu() {
  try {
    const snap = await getDocs(collection(db, 'products'));
    products = [];
    snap.forEach(d => products.push({ id: d.id, ...d.data() }));
    document.getElementById('prodCount').textContent = `${products.length} Items`;
    renderCategoryPills();
    filterCatalog();
  } catch (e) {
    document.getElementById('prodCount').textContent = "Offline / Error";
  }
}

function renderCategoryPills() {
  const cats = ['ALL', ...new Set(products.map(p => p.category || 'Other'))];
  const container = document.getElementById('catFilter');
  container.innerHTML = cats.map(c => `
    <button class="${c === selectedCategory ? 'active' : ''}" onclick="selectCat('${c}')">${c}</button>
  `).join('');
}

window.selectCat = (c) => {
  selectedCategory = c;
  renderCategoryPills();
  filterCatalog();
};

window.filterCatalog = () => {
  const q = (document.getElementById('posSearch')?.value || '').toLowerCase();
  const catalogEl = document.getElementById('posCatalog');
  let filtered = products;

  if (selectedCategory !== 'ALL') {
    filtered = filtered.filter(p => (p.category || 'Other') === selectedCategory);
  }
  if (q) {
    filtered = filtered.filter(p => (p.name || '').toLowerCase().includes(q));
  }

  let h = '';
  filtered.forEach(p => {
    const isOut = (p.qty || 0) <= 0;
    h += `
      <div class="pos-item" style="${isOut ? 'opacity:0.4;pointer-events:none;' : ''}" onclick="addToCart('${p.id}')">
        <div class="pos-item-name">${p.name}</div>
        <div class="pos-item-price">₱${p.price || 0}</div>
        ${isOut ? '<small style="color:red;font-weight:bold;">Out of stock</small>' : ''}
      </div>
    `;
  });

  catalogEl.innerHTML = h || '<div style="grid-column:1/-1;text-align:center;color:#888;padding:20px;">No items match</div>';
};

window.addToCart = (id) => {
  cart[id] = (cart[id] || 0) + 1;
  renderCart();
};

window.changeQty = (id, delta) => {
  cart[id] = Math.max(0, (cart[id] || 0) + delta);
  if (cart[id] === 0) {
    delete cart[id];
    delete bobaMap[id];
  }
  renderCart();
};

window.toggleBoba = (id) => {
  bobaMap[id] = !bobaMap[id];
  renderCart();
};

function renderCart() {
  const list = document.getElementById('cartList');
  const entries = Object.entries(cart);
  let total = 0;

  if (!entries.length) {
    list.innerHTML = '<div style="text-align:center;color:#888;padding:20px 0;">Cart is empty.<br>Tap items to add.</div>';
    document.getElementById('cartTotal').textContent = '0';
    return;
  }

  let h = '';
  entries.forEach(([id, qty]) => {
    const p = products.find(x => x.id === id);
    if (!p) return;
    const isMilkTea = (p.category || '').toLowerCase() === 'milk tea';
    const bobaActive = !!bobaMap[id];
    const itemTotal = (p.price * qty) + (bobaActive ? (5 * qty) : 0);
    total += itemTotal;

    h += `
      <div class="cart-row">
        <div>
          <b>${p.name}</b> (₱${p.price})
          ${isMilkTea ? `<br><label style="font-size:12px;cursor:pointer;"><input type="checkbox" ${bobaActive ? 'checked' : ''} onchange="toggleBoba('${id}')"> +Boba ₱5</label>` : ''}
        </div>
        <div class="qty-ctrl">
          <button onclick="changeQty('${id}', -1)">-</button>
          <span><b>${qty}</b></span>
          <button onclick="changeQty('${id}', 1)">+</button>
          <span style="min-width:55px;text-align:right;font-weight:bold;">₱${itemTotal}</span>
        </div>
      </div>
    `;
  });

  list.innerHTML = h;
  document.getElementById('cartTotal').textContent = total.toLocaleString();
}

async function getNextOrderNumber() {
  const ref = doc(db, 'counters', 'orders');
  let n = 0;
  await runTransaction(db, async tx => {
    const s = await tx.get(ref);
    n = (s.data()?.lastOrderNumber || 0) + 1;
    tx.update(ref, { lastOrderNumber: n });
  });
  return n;
}

window.submitPosOrder = async () => {
  const items = [];
  let total = 0;

  Object.entries(cart).forEach(([id, qty]) => {
    const p = products.find(x => x.id === id);
    if (!p) return;
    const boba = !!bobaMap[id];
    const itemTotal = (p.price * qty) + (boba ? (5 * qty) : 0);
    total += itemTotal;
    items.push({
      name: p.name,
      qty: qty,
      price: p.price || 0,
      boba: boba
    });
  });

  if (!items.length) {
    return alert('Please select items before charging.');
  }

  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Submitting...';

  try {
    const n = await getNextOrderNumber();
    const formattedOrderNo = `CK-${String(n).padStart(4, '0')}`;
    const customer = document.getElementById('customerName').value.trim() || 'Walk-in';
    const notes = document.getElementById('orderNotes').value.trim();
    const paymentMethod = document.getElementById('paymentMethod').value;
    const track = `track_rc1.html?order=${formattedOrderNo}`;

    const orderData = {
      orderNumber: formattedOrderNo,
      customerName: customer,
      notes: notes,
      items: items,
      paymentMethod: paymentMethod,
      total: total,
      status: 'ORDER_RECEIVED',
      createdAt: new Date().toISOString(),
      trackingLink: track
    };

    await setDoc(doc(db, 'orders', formattedOrderNo), orderData);

    alert(`Order ${formattedOrderNo} charged and sent to kitchen!`);

    // Reset form
    cart = {};
    bobaMap = {};
    document.getElementById('customerName').value = 'Walk-in';
    document.getElementById('orderNotes').value = '';
    renderCart();
  } catch (err) {
    alert('Failed to submit order: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = '🚀 Charge & Send to Kitchen';
  }
};

loadMenu();
</script>
</body>
</html>
